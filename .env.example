# Password for the Kanalog-only login role in the existing PostgreSQL server.
RDB_PASSWORD=
# Compose uses the existing Docker network `infra-backend` and service `infra-postgres`.
RDB_HOST=jdbc:postgresql://infra-postgres:5432/kanalog
# For local use. Set the browser-visible HTTPS URL behind your own reverse proxy.
PUBLIC_APP_URL=http://localhost:3200
COOKIE_SECURE=false
APP_BIND_IP=127.0.0.1
APP_PORT=3200
